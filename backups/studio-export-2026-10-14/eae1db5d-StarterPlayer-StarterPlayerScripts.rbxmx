					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
--[[
	AvatarCreatorCamera
	Caméra scriptable de l'écran de création : placée face au personnage, légèrement décalée
	pour le laisser dans la partie gauche de l'écran (le panneau d'options occupe la droite).

	Recalculée à chaque frame à partir du HumanoidRootPart : elle suit donc toute seule les
	changements de taille et un éventuel nouveau personnage.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local RENDER_STEP_NAME = "AvatarCreatorCamera"

local FIELD_OF_VIEW = 40
local START_DISTANCE = 17 -- distance avant le travelling d'ouverture (studs)
local END_DISTANCE = 9.5 -- distance finale
local CAMERA_HEIGHT = 1 -- hauteur de la caméra au-dessus du point visé
local FOCUS_HEIGHT = 0.2 -- point visé, par rapport au centre du RootPart
local SIDE_OFFSET = 2.2 -- décalage latéral : pousse le personnage vers la gauche de l'écran
local SWAY_AMPLITUDE = 0.1 -- "respiration" verticale de la caméra
local SWAY_SPEED = 0.6

local localPlayer = Players.LocalPlayer

local AvatarCreatorCamera = {}

local isRunning = false
local savedFieldOfView = 70
local dollyStartClock: number? = nil
local dollyDuration = 1

local function getDistance(): number
	if dollyStartClock == nil then
		return START_DISTANCE
	end
	local progress = math.clamp((os.clock() - dollyStartClock) / dollyDuration, 0, 1)
	local eased = TweenService:GetValue(progress, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
	return START_DISTANCE + (END_DISTANCE - START_DISTANCE) * eased
end

local function update()
	local camera = workspace.CurrentCamera
	local character = localPlayer.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if camera == nil or rootPart == nil or not rootPart:IsA("BasePart") then
		return
	end

	-- Les scripts caméra par défaut peuvent reprendre la main (au respawn par exemple).
	if camera.CameraType ~= Enum.CameraType.Scriptable then
		camera.CameraType = Enum.CameraType.Scriptable
	end
	camera.FieldOfView = FIELD_OF_VIEW

	local rootCFrame = rootPart.CFrame
	local screenRight = -rootCFrame.RightVector -- la droite de l'écran est la gauche du personnage
	local sway = math.sin(os.clock() * SWAY_SPEED) * SWAY_AMPLITUDE

	local focus = rootCFrame.Position + Vector3.new(0, FOCUS_HEIGHT, 0) + screenRight * SIDE_OFFSET
	local position = focus + rootCFrame.LookVector * getDistance() + Vector3.new(0, CAMERA_HEIGHT + sway, 0)

	camera.CFrame = CFrame.lookAt(position, focus)
end

-- Verrouille la caméra face au personnage, à START_DISTANCE.
function AvatarCreatorCamera.start()
	if isRunning then
		return
	end
	isRunning = true
	dollyStartClock = nil

	local camera = workspace.CurrentCamera
	if camera then
		savedFieldOfView = camera.FieldOfView
	end
	RunService:BindToRenderStep(RENDER_STEP_NAME, Enum.RenderPriority.Camera.Value + 1, update)
end

-- Lance le travelling avant jusqu'à END_DISTANCE.
function AvatarCreatorCamera.dollyIn(duration: number)
	dollyStartClock = os.clock()
	dollyDuration = math.max(duration, 0.01)
end

-- Rend la caméra au joueur.
function AvatarCreatorCamera.stop()
	if not isRunning then
		return
	end
	isRunning = false
	RunService:UnbindFromRenderStep(RENDER_STEP_NAME)

	local camera = workspace.CurrentCamera
	if camera then
		camera.FieldOfView = savedFieldOfView
		camera.CameraType = Enum.CameraType.Custom
	end
end

return AvatarCreatorCamera
]]></ProtectedString>
						<string name="ScriptGuid">{8401AB3F-76DB-4586-AAB4-84773B7348B7}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">AvatarCreatorCamera</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX06E2F7009AC7455B802C8BEDD1367911">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
--[[
	AvatarCreatorView
	Construit le ScreenGui du Hub de création, entièrement par code (rien à poser dans StarterGui,
	et l'interface est versionnée avec le reste). Ce module ne contient AUCUNE logique : il crée les
	instances et les expose, c'est AvatarCreatorController qui les anime et écoute les boutons.

	Le panneau a deux pages, affichées l'une après l'autre :
		1. ÉVEIL  : l'apparence (7 sélecteurs "< valeur >") et le bouton pour continuer ;
		2. DESTIN : le choix de la Magie Innée (un bouton par magie), sa description, la validation.

	Arborescence produite :
		AvatarCreatorGui (ScreenGui)
		├── Panel (CanvasGroup)          panneau, à droite
		│   ├── Shade                    dégradé noir qui fond vers la scène
		│   └── Content
		│       ├── AppearancePage
		│       └── DestinyPage
		└── Fade (Frame)                 voile noir plein écran (intro et transitions)
		    └── IntroLabel               texte de narration
]]

local COLOR_BACKGROUND = Color3.fromRGB(6, 6, 9)
local COLOR_TEXT = Color3.fromRGB(226, 220, 208)
local COLOR_MUTED = Color3.fromRGB(128, 122, 114)
local COLOR_ACCENT = Color3.fromRGB(176, 146, 96) -- or terni

local FONT_TITLE = Enum.Font.Garamond
local FONT_CAPTION = Enum.Font.GothamMedium

local PANEL_WIDTH_SCALE = 0.34
local LIST_PADDING = 10
local STEPPER_HEIGHT = 52
local STEPPER_BUTTON_SIZE = 34
local MAGIC_BUTTON_HEIGHT = 44
local MAGIC_DESCRIPTION_HEIGHT = 92
-- Hauteur d'écran (pixels) pour laquelle le contenu est dessiné. En dessous, il rétrécit en bloc.
local REFERENCE_SCREEN_HEIGHT = 640

-- Sélecteur "< valeur >" : sert aux listes (coiffures, visages...) comme aux échelles.
export type Stepper = {
	valueLabel: TextLabel,
	counterLabel: TextLabel, -- position dans la liste, ex. "3 / 15" (vide pour une échelle)
	previousButton: TextButton,
	nextButton: TextButton,
}

-- Bouton d'une Magie Innée dans la page DESTIN.
export type MagicButton = {
	button: TextButton,
	stroke: UIStroke, -- liseré, mis en avant quand la magie est sélectionnée
}

-- Ce que la vue a besoin de savoir d'une magie pour dessiner son bouton.
export type MagicEntry = {
	name: string,
	color: Color3,
}

export type View = {
	gui: ScreenGui,
	panel: CanvasGroup,
	fade: Frame,
	introLabel: TextLabel,

	appearancePage: Frame,
	baseStepper: Stepper,
	faceStepper: Stepper,
	markStepper: Stepper,
	hairStepper: Stepper,
	outfitStepper: Stepper,
	heightStepper: Stepper,
	widthStepper: Stepper,
	nextButton: TextButton,

	destinyPage: Frame,
	magicButtons: { MagicButton },
	magicDescription: TextLabel,
	confirmButton: TextButton,
	backButton: TextButton,
}

local AvatarCreatorView = {}

--------------------------------------------------------------------------------
-- Briques de base
--------------------------------------------------------------------------------

local function newLabel(text: string, font: Enum.Font, textSize: number, color: Color3): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Font = font
	label.Text = text
	label.TextSize = textSize
	label.TextColor3 = color
	return label
end

local function newArrowButton(text: string): TextButton
	local button = Instance.new("TextButton")
	button.AutoButtonColor = false
	button.BackgroundTransparency = 1
	button.Size = UDim2.fromOffset(STEPPER_BUTTON_SIZE, STEPPER_BUTTON_SIZE)
	button.Font = FONT_TITLE
	button.Text = text
	button.TextSize = 28
	button.TextColor3 = COLOR_ACCENT
	return button
end

local function newSeparator(layoutOrder: number, parent: Instance)
	local separator = Instance.new("Frame")
	separator.Name = "Separator"
	separator.BorderSizePixel = 0
	separator.BackgroundColor3 = COLOR_ACCENT
	separator.BackgroundTransparency = 0.5
	separator.Size = UDim2.new(0.5, 0, 0, 1)
	separator.LayoutOrder = layoutOrder
	separator.Parent = parent
end

-- Titre + sous-titre + séparateur en tête d'une page (LayoutOrder 1 à 3).
local function newPageHeader(title: string, subtitle: string, parent: Instance)
	local titleLabel = newLabel(title, FONT_TITLE, 40, COLOR_TEXT)
	titleLabel.Name = "Title"
	titleLabel.Size = UDim2.new(1, 0, 0, 44)
	titleLabel.LayoutOrder = 1
	titleLabel.Parent = parent

	local subtitleLabel = newLabel(subtitle, FONT_TITLE, 18, COLOR_MUTED)
	subtitleLabel.Name = "Subtitle"
	subtitleLabel.Size = UDim2.new(1, 0, 0, 20)
	subtitleLabel.LayoutOrder = 2
	subtitleLabel.Parent = parent

	newSeparator(3, parent)
end

-- Grand bouton à liseré doré (continuer, valider).
local function newWideButton(name: string, text: string, layoutOrder: number, parent: Instance): TextButton
	local button = Instance.new("TextButton")
	button.Name = name
	button.AutoButtonColor = false
	button.BackgroundColor3 = COLOR_ACCENT
	button.BackgroundTransparency = 1
	button.Size = UDim2.new(1, 0, 0, 44)
	button.Font = FONT_TITLE
	button.Text = text
	button.TextSize = 22
	button.TextColor3 = COLOR_TEXT
	button.LayoutOrder = layoutOrder
	button.Parent = parent

	local stroke = Instance.new("UIStroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Color = COLOR_ACCENT
	stroke.Thickness = 1
	stroke.Parent = button

	return button
end

-- Une page du panneau : un cadre plein, dont les enfants s'empilent verticalement, centrés.
local function newPage(name: string, parent: Instance): Frame
	local page = Instance.new("Frame")
	page.Name = name
	page.BackgroundTransparency = 1
	page.Size = UDim2.fromScale(1, 1)
	page.Parent = parent

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Vertical
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, LIST_PADDING)
	layout.Parent = page

	return page
end

local function newStepper(name: string, caption: string, layoutOrder: number, parent: Instance): Stepper
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.BackgroundTransparency = 1
	frame.Size = UDim2.new(1, 0, 0, STEPPER_HEIGHT)
	frame.LayoutOrder = layoutOrder
	frame.Parent = parent

	local captionLabel = newLabel(caption, FONT_CAPTION, 12, COLOR_MUTED)
	captionLabel.Name = "Caption"
	captionLabel.Size = UDim2.new(1, 0, 0, 16)
	captionLabel.Parent = frame

	local counterLabel = newLabel("", FONT_CAPTION, 11, COLOR_MUTED)
	counterLabel.Name = "Counter"
	counterLabel.Size = UDim2.new(1, 0, 0, 16)
	counterLabel.TextXAlignment = Enum.TextXAlignment.Right
	counterLabel.Parent = frame

	local previousButton = newArrowButton("<")
	previousButton.Name = "Previous"
	previousButton.AnchorPoint = Vector2.new(0, 1)
	previousButton.Position = UDim2.fromScale(0, 1)
	previousButton.Parent = frame

	local nextButton = newArrowButton(">")
	nextButton.Name = "Next"
	nextButton.AnchorPoint = Vector2.new(1, 1)
	nextButton.Position = UDim2.fromScale(1, 1)
	nextButton.Parent = frame

	local valueLabel = newLabel("", FONT_TITLE, 24, COLOR_TEXT)
	valueLabel.Name = "Value"
	valueLabel.AnchorPoint = Vector2.new(0.5, 1)
	valueLabel.Position = UDim2.fromScale(0.5, 1)
	valueLabel.Size = UDim2.new(1, -2 * STEPPER_BUTTON_SIZE, 0, STEPPER_BUTTON_SIZE)
	valueLabel.TextScaled = true -- les noms longs rétrécissent au lieu de déborder
	valueLabel.Parent = frame

	local valueSizeLimit = Instance.new("UITextSizeConstraint")
	valueSizeLimit.MinTextSize = 12
	valueSizeLimit.MaxTextSize = 23
	valueSizeLimit.Parent = valueLabel

	return {
		valueLabel = valueLabel,
		counterLabel = counterLabel,
		previousButton = previousButton,
		nextButton = nextButton,
	}
end

-- Bouton d'une magie : son nom, précédé d'une barre à sa couleur.
local function newMagicButton(entry: MagicEntry, layoutOrder: number, parent: Instance): MagicButton
	local button = Instance.new("TextButton")
	button.Name = "Magic" .. layoutOrder
	button.AutoButtonColor = false
	button.BackgroundColor3 = entry.color
	button.BackgroundTransparency = 1
	button.Size = UDim2.new(1, 0, 0, MAGIC_BUTTON_HEIGHT)
	button.Font = FONT_TITLE
	button.Text = entry.name
	button.TextSize = 24
	button.TextColor3 = COLOR_TEXT
	button.LayoutOrder = layoutOrder
	button.Parent = parent

	local stroke = Instance.new("UIStroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Color = entry.color
	stroke.Thickness = 1
	stroke.Transparency = 0.75
	stroke.Parent = button

	local swatch = Instance.new("Frame")
	swatch.Name = "Swatch"
	swatch.BorderSizePixel = 0
	swatch.BackgroundColor3 = entry.color
	swatch.Size = UDim2.new(0, 4, 1, 0)
	swatch.Parent = button

	return {
		button = button,
		stroke = stroke,
	}
end

--------------------------------------------------------------------------------
-- Construction
--------------------------------------------------------------------------------

-- `magicEntries` : une entrée par Magie Innée, dans l'ordre de MagicConfig.MAGICS.
function AvatarCreatorView.create(parent: Instance, magicEntries: { MagicEntry }): View
	local gui = Instance.new("ScreenGui")
	gui.Name = "AvatarCreatorGui"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 50
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Enabled = false

	-- Panneau ---------------------------------------------------------------
	local panel = Instance.new("CanvasGroup") -- CanvasGroup : permet de fondre tout le panneau d'un coup
	panel.Name = "Panel"
	panel.BackgroundTransparency = 1
	panel.AnchorPoint = Vector2.new(1, 0)
	panel.Position = UDim2.fromScale(1, 0)
	panel.Size = UDim2.fromScale(PANEL_WIDTH_SCALE, 1)
	panel.Parent = gui

	local shade = Instance.new("Frame")
	shade.Name = "Shade"
	shade.BorderSizePixel = 0
	shade.BackgroundColor3 = COLOR_BACKGROUND
	shade.Size = UDim2.fromScale(1, 1)
	shade.Parent = panel

	local shadeGradient = Instance.new("UIGradient")
	shadeGradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.45, 0.25),
		NumberSequenceKeypoint.new(1, 0.1),
	})
	shadeGradient.Parent = shade

	local content = Instance.new("Frame")
	content.Name = "Content"
	content.BackgroundTransparency = 1
	content.AnchorPoint = Vector2.new(1, 0.5)
	content.Position = UDim2.fromScale(1, 0.5)
	content.Size = UDim2.fromScale(0.8, 1)
	content.Parent = panel

	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, 16)
	padding.PaddingRight = UDim.new(0, 32)
	padding.Parent = content

	-- Sur un petit écran (ou une petite fenêtre Studio), tout le contenu rétrécit pour rester visible.
	local contentScale = Instance.new("UIScale")
	contentScale.Parent = content

	local function updateContentScale()
		contentScale.Scale = math.min(1, gui.AbsoluteSize.Y / REFERENCE_SCREEN_HEIGHT)
	end
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateContentScale)

	-- Page 1 : apparence ------------------------------------------------------
	local appearancePage = newPage("AppearancePage", content)
	newPageHeader("É V E I L", "Souvenez-vous de qui vous étiez.", appearancePage)

	local baseStepper = newStepper("Base", "CORPS", 4, appearancePage)
	local faceStepper = newStepper("Face", "VISAGE", 5, appearancePage)
	local markStepper = newStepper("Mark", "CICATRICES ET TATOUAGES", 6, appearancePage)
	local hairStepper = newStepper("Hair", "CHEVELURE", 7, appearancePage)
	local outfitStepper = newStepper("Outfit", "TENUE", 8, appearancePage)
	local heightStepper = newStepper("Height", "TAILLE", 9, appearancePage)
	local widthStepper = newStepper("Width", "CARRURE", 10, appearancePage)

	newSeparator(11, appearancePage)
	local nextButton = newWideButton("Next", "CONTINUER", 12, appearancePage)

	-- Page 2 : Magie Innée ----------------------------------------------------
	local destinyPage = newPage("DestinyPage", content)
	destinyPage.Visible = false
	newPageHeader("D E S T I N", "Une seule magie coule dans vos veines.", destinyPage)

	local magicButtons: { MagicButton } = {}
	for index, entry in magicEntries do
		magicButtons[index] = newMagicButton(entry, 3 + index, destinyPage)
	end
	local afterMagics = 3 + #magicEntries

	local magicDescription = newLabel("", FONT_TITLE, 17, COLOR_MUTED)
	magicDescription.Name = "MagicDescription"
	magicDescription.Size = UDim2.new(1, 0, 0, MAGIC_DESCRIPTION_HEIGHT)
	magicDescription.TextWrapped = true
	magicDescription.TextYAlignment = Enum.TextYAlignment.Top
	magicDescription.RichText = true
	magicDescription.LayoutOrder = afterMagics + 1
	magicDescription.Parent = destinyPage

	newSeparator(afterMagics + 2, destinyPage)
	local confirmButton = newWideButton("Confirm", "", afterMagics + 3, destinyPage)

	local backButton = Instance.new("TextButton")
	backButton.Name = "Back"
	backButton.AutoButtonColor = false
	backButton.BackgroundTransparency = 1
	backButton.Size = UDim2.new(1, 0, 0, 24)
	backButton.Font = FONT_TITLE
	backButton.Text = "Revenir à l'apparence"
	backButton.TextSize = 17
	backButton.TextColor3 = COLOR_MUTED
	backButton.LayoutOrder = afterMagics + 4
	backButton.Parent = destinyPage

	-- Voile noir + narration (au-dessus de tout) -----------------------------
	local fade = Instance.new("Frame")
	fade.Name = "Fade"
	fade.BorderSizePixel = 0
	fade.BackgroundColor3 = Color3.new(0, 0, 0)
	fade.Size = UDim2.fromScale(1, 1)
	fade.ZIndex = 10
	fade.Parent = gui

	local introLabel = newLabel("", FONT_TITLE, 30, COLOR_TEXT)
	introLabel.Name = "IntroLabel"
	introLabel.AnchorPoint = Vector2.new(0.5, 0.5)
	introLabel.Position = UDim2.fromScale(0.5, 0.5)
	introLabel.Size = UDim2.fromScale(0.8, 0.2)
	introLabel.TextWrapped = true
	introLabel.TextTransparency = 1
	introLabel.ZIndex = 11
	introLabel.Parent = fade

	gui.Parent = parent
	updateContentScale()

	return {
		gui = gui,
		panel = panel,
		fade = fade,
		introLabel = introLabel,

		appearancePage = appearancePage,
		baseStepper = baseStepper,
		faceStepper = faceStepper,
		markStepper = markStepper,
		hairStepper = hairStepper,
		outfitStepper = outfitStepper,
		heightStepper = heightStepper,
		widthStepper = widthStepper,
		nextButton = nextButton,

		destinyPage = destinyPage,
		magicButtons = magicButtons,
		magicDescription = magicDescription,
		confirmButton = confirmButton,
		backButton = backButton,
	}
end

return AvatarCreatorView
]]></ProtectedString>
						<string name="ScriptGuid">{21577DCC-EB58-4754-9D53-3F4197AFCDD5}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<string name="Name">AvatarCreatorView</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					</Properties>
				</Item>
			</Item>
			<Item class="Folder" referent="RBXEBF2A80DE9C9433C8F3281EB4D4B4FA6">
				<Properties>
					<Color3 name="IconTint">
						<R>0</R>
						<G>0</G>
						<B>0</B>
					</Color3>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<string name="Name">Combat</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				</Properties>
				<Item class="LocalScript" referent="RBXF7B5433C3EDF4F44A47881832E1D20EA">
					<Properties>
						<ProtectedString name="Source"><![CDATA[--!strict
--[[
	CombatController (LocalScript)
	Chef d'orchestre du combat côté client :
		- clic gauche : combo à l'épée (enchaînement, mémoire d'un clic, remise à zéro) ;
		  le coup part tout de suite en local (soft-lock, animation, traînée, zone de frappe) ;
		- soft-lock : au départ de chaque coup, le personnage se tourne vers l'ennemi le plus proche ;
		- zone de frappe : pendant la fenêtre de frappe, et seulement là, tout ennemi présent dans
		  la boîte devant le joueur est signalé au serveur (SpatialHitbox) ;
		- jauge de Tension : suit l'attribut du Player écrit par le serveur ;
		- touche E : demande l'ultime de sa Magie Innée quand la jauge est pleine ;
		- déclenche les VFX (CombatEffects) en réaction aux événements du serveur.

	Règle de base : rien ici ne tourne en continu. Tout part d'une entrée du joueur
	(onAttackInput, onUltimateInput) ou d'un événement du serveur.

	Le client ne retire jamais de points de vie et ne touche jamais à la Tension :
	il demande (RequestAttack, ReportHit, RequestUltimate), CombatService vérifie et décide.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local sharedFolder = ReplicatedStorage:WaitForChild("Shared")
local combatFolder = sharedFolder:WaitForChild("Combat")
local AvatarConfig = require(sharedFolder:WaitForChild("Avatar"):WaitForChild("AvatarConfig") :: ModuleScript)
local MagicConfig = require(sharedFolder:WaitForChild("Magic"):WaitForChild("MagicConfig") :: ModuleScript)
local Config = require(combatFolder:WaitForChild("CombatConfig") :: ModuleScript)
local Remotes = require(combatFolder:WaitForChild("CombatRemotes") :: ModuleScript)
local SpatialHitbox = require(combatFolder:WaitForChild("SpatialHitbox") :: ModuleScript)

local CombatEffects = require(script.Parent:WaitForChild("CombatEffects") :: ModuleScript)
local SoftLock = require(script.Parent:WaitForChild("SoftLock") :: ModuleScript)
local SwingAnimator = require(script.Parent:WaitForChild("SwingAnimator") :: ModuleScript)
local TensionView = require(script.Parent:WaitForChild("TensionView") :: ModuleScript)

local GAUGE_FILL_DURATION = 0.25 -- la barre glisse vers sa nouvelle valeur
local GAUGE_PULSE_DURATION = 0.6 -- demi-période du clignotement quand la jauge est pleine
local GAUGE_STROKE_TRANSPARENCY = 0.4 -- liseré de la barre au repos (même valeur que dans TensionView)

local localPlayer = Players.LocalPlayer
local tensionView = TensionView.create(localPlayer:WaitForChild("PlayerGui"))

--------------------------------------------------------------------------------
-- État
--------------------------------------------------------------------------------

local isAttacking = false -- un coup (ou un enchaînement) est en cours
local hasBufferedInput = false -- un clic est arrivé pendant le coup : il déclenchera le suivant
local lastComboIndex = 0 -- dernier coup terminé (0 = aucun)
local lastAttackEndClock = 0 -- os.clock() de fin du dernier coup

local hitbox: any = nil -- SpatialHitbox du personnage actuel
local hitboxRootPart: BasePart? = nil

local gaugePulseTweens: { Tween } = {} -- clignotement de la jauge pleine (vide = pas de clignotement)

--------------------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------------------

-- Retourne le personnage local, son Humanoid, son RootPart et son épée s'il est en état d'agir.
local function getReadyCharacter(): (Model?, Humanoid?, BasePart?, Instance?)
	local character = localPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = humanoid and humanoid.RootPart
	local sword = character and character:FindFirstChild(Config.SWORD_NAME)
	if character == nil or humanoid == nil or rootPart == nil or sword == nil then
		return nil, nil, nil, nil
	end
	-- Un RootPart ancré = joueur figé par le serveur (Hub, anomalie, rewind).
	if humanoid.Health <= 0 or rootPart.Anchored then
		return nil, nil, nil, nil
	end
	return character, humanoid, rootPart, sword
end

-- La zone de frappe est liée à un RootPart précis : on la reconstruit quand il change (respawn).
local function getHitbox(character: Model, rootPart: BasePart): any
	if hitboxRootPart ~= rootPart then
		hitbox = SpatialHitbox.new(rootPart, { character })
		hitboxRootPart = rootPart
	end
	return hitbox
end

-- Taille de la zone de frappe du coup `step` : la boîte de base, étirée vers l'avant par son allonge.
local function getHitboxSize(step: any): Vector3
	return Config.HITBOX_SIZE + Vector3.new(0, 0, step.reachBonus)
end

local function getTension(): number
	local tension = localPlayer:GetAttribute(Config.TENSION_ATTRIBUTE)
	return if type(tension) == "number" then tension else 0
end

-- Magie Innée du joueur local (la première de la liste tant qu'il n'a pas choisi).
local function getMagic(): any
	return MagicConfig.getById(localPlayer:GetAttribute(MagicConfig.ATTRIBUTE))
end

local function onHitboxHit(target: Model, position: Vector3)
	-- Retour immédiat pour l'attaquant (impact, hit-stop, secousse), sans attendre le serveur.
	CombatEffects.playSwordHit(localPlayer.Character, target, position, true)
	Remotes.ReportHit:FireServer(target)
end

--------------------------------------------------------------------------------
-- Combo à l'épée
--------------------------------------------------------------------------------

-- Le combo continue si le coup précédent n'était pas le dernier et vient juste de finir.
local function getNextComboIndex(): number
	local isComboAlive = lastComboIndex > 0
		and lastComboIndex < #Config.COMBO
		and os.clock() - lastAttackEndClock <= Config.COMBO_RESET_DELAY
	return if isComboAlive then lastComboIndex + 1 else 1
end

-- Soft-lock : tourne le personnage vers l'ennemi le plus proche et verrouille cette orientation.
-- Retourne la fonction qui rend la rotation automatique au Humanoid (à appeler en fin de frappe).
local function lockOntoNearestEnemy(character: Model, humanoid: Humanoid, rootPart: BasePart): () -> ()
	local target = if Config.SOFT_LOCK_RADIUS > 0
		then SoftLock.findTarget(character, rootPart, Config.SOFT_LOCK_RADIUS)
		else nil
	if target == nil then
		return function() end
	end

	SoftLock.face(rootPart, target)

	-- Sans cela, un joueur qui se déplace serait aussitôt retourné vers sa direction de marche
	-- et la zone de frappe partirait à côté.
	local previousAutoRotate = humanoid.AutoRotate
	humanoid.AutoRotate = false
	return function()
		humanoid.AutoRotate = previousAutoRotate
	end
end

-- Exécute UN coup du début à la fin. YIELD pendant toute sa durée.
local function performAttack(character: Model, humanoid: Humanoid, rootPart: BasePart, sword: Instance, comboIndex: number)
	local step = Config.COMBO[comboIndex]
	local hitWindow = step.hitEnd - step.hitStart

	local releaseLock = lockOntoNearestEnemy(character, humanoid, rootPart)
	Remotes.RequestAttack:FireServer(comboIndex)
	SwingAnimator.play(character, step)

	-- Fenêtre de frappe : traînée et zone de frappe ne vivent qu'entre hitStart et hitEnd.
	-- La zone s'éteint d'elle-même au bout de la durée donnée (voir SpatialHitbox.start).
	task.wait(step.hitStart)
	if localPlayer.Character == character then
		CombatEffects.playBladeTrail(sword, hitWindow)
		getHitbox(character, rootPart):start(hitWindow, getHitboxSize(step), onHitboxHit)
	end

	task.wait(hitWindow)
	releaseLock()

	task.wait(step.duration - step.hitEnd)
end

-- Seul point d'entrée d'une attaque à l'épée : appelé une fois par clic gauche.
local function onAttackInput()
	-- Clic pendant un coup : on le retient, il lancera le coup suivant dès la fin de celui-ci.
	if isAttacking then
		hasBufferedInput = true
		return
	end

	isAttacking = true
	repeat
		hasBufferedInput = false -- le clic qui nous amène ici est consommé

		local character, humanoid, rootPart, sword = getReadyCharacter()
		if character == nil or humanoid == nil or rootPart == nil or sword == nil then
			break
		end

		-- pcall : une erreur pendant un coup ne doit pas laisser isAttacking bloqué à true.
		local comboIndex = getNextComboIndex()
		local isCompleted, errorMessage = pcall(performAttack, character, humanoid, rootPart, sword, comboIndex)
		if not isCompleted then
			humanoid.AutoRotate = true -- le soft-lock n'a peut-être pas pu rendre la rotation
			warn(`[Combat] Coup interrompu : {errorMessage}`)
			break
		end
		lastComboIndex = comboIndex
		lastAttackEndClock = os.clock()
	until not hasBufferedInput -- pas de nouveau clic pendant le coup : on s'arrête
	isAttacking = false
end

-- Mort ou respawn : on oublie le combo et on coupe la zone de frappe du coup en cours.
local function resetCombat()
	hasBufferedInput = false
	lastComboIndex = 0
	if hitbox then
		hitbox:stop()
	end
end

--------------------------------------------------------------------------------
-- Pouvoir ultime
--------------------------------------------------------------------------------

-- Seul point d'entrée de l'ultime : appelé une fois par appui sur ULTIMATE_INPUT.
-- Ce test local évite juste d'envoyer une demande inutile ; c'est le serveur qui vérifie la jauge.
local function onUltimateInput()
	if getTension() < Config.TENSION_MAX or getReadyCharacter() == nil then
		return
	end
	Remotes.RequestUltimate:FireServer()
end

--------------------------------------------------------------------------------
-- Jauge de Tension
--------------------------------------------------------------------------------

local function stopGaugePulse()
	for _, pulseTween in gaugePulseTweens do
		pulseTween:Cancel()
	end
	gaugePulseTweens = {}
	tensionView.barStroke.Transparency = GAUGE_STROKE_TRANSPARENCY
	tensionView.prompt.TextTransparency = 0
end

-- Jauge pleine : le liseré et l'invite clignotent jusqu'à ce que la Tension soit dépensée.
-- (Deux tweens en boucle, arrêtés par stopGaugePulse : aucun script ne tourne pendant ce temps.)
local function startGaugePulse()
	if #gaugePulseTweens > 0 then
		return
	end
	local pulseInfo = TweenInfo.new(GAUGE_PULSE_DURATION, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)

	tensionView.barStroke.Transparency = 0
	gaugePulseTweens = {
		TweenService:Create(tensionView.barStroke, pulseInfo, { Transparency = 0.7 }),
		TweenService:Create(tensionView.prompt, pulseInfo, { TextTransparency = 0.6 }),
	}
	for _, pulseTween in gaugePulseTweens do
		pulseTween:Play()
	end
end

-- Recopie la Tension du serveur dans l'interface. Appelé à chaque changement de l'attribut.
local function refreshGauge()
	local ratio = math.clamp(getTension() / Config.TENSION_MAX, 0, 1)
	local isFull = ratio >= 1

	local fillInfo = TweenInfo.new(GAUGE_FILL_DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(tensionView.fill, fillInfo, { Size = UDim2.fromScale(ratio, 1) }):Play()

	tensionView.prompt.Visible = isFull
	if isFull then
		startGaugePulse()
	else
		stopGaugePulse()
	end
end

-- L'invite porte le nom de l'ultime du joueur, à la couleur de sa magie.
local function refreshUltimatePrompt()
	local magic = getMagic()
	tensionView.prompt.Text = `[{Config.ULTIMATE_INPUT.Name}]  {magic.ultimateName}`
	tensionView.prompt.TextColor3 = magic.palette.glow
end

-- La jauge est masquée tant que le joueur est dans le Hub de création.
local function refreshGaugeVisibility()
	tensionView.gui.Enabled = localPlayer:GetAttribute(AvatarConfig.CUSTOMIZING_ATTRIBUTE) ~= true
end

localPlayer:GetAttributeChangedSignal(Config.TENSION_ATTRIBUTE):Connect(refreshGauge)
localPlayer:GetAttributeChangedSignal(MagicConfig.ATTRIBUTE):Connect(refreshUltimatePrompt)
localPlayer:GetAttributeChangedSignal(AvatarConfig.CUSTOMIZING_ATTRIBUTE):Connect(refreshGaugeVisibility)
refreshGauge()
refreshUltimatePrompt()
refreshGaugeVisibility()

--------------------------------------------------------------------------------
-- Entrée joueur
--------------------------------------------------------------------------------

UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
	if gameProcessed then
		return -- clic sur l'interface, saisie dans le chat...
	end

	if input.UserInputType == Config.ATTACK_INPUT then
		onAttackInput()
	elseif input.KeyCode == Config.ULTIMATE_INPUT then
		onUltimateInput()
	end
end)

localPlayer.CharacterAdded:Connect(resetCombat)

--------------------------------------------------------------------------------
-- Événements serveur
--------------------------------------------------------------------------------

-- Un AUTRE joueur attaque : son animation est déjà répliquée par Roblox, il ne manque que
-- la traînée de sa lame, à allumer chez nous pendant sa fenêtre de frappe.
Remotes.AttackStarted.OnClientEvent:Connect(function(attacker: Model?, comboIndex: number)
	local step = Config.COMBO[comboIndex]
	local sword = attacker and attacker:FindFirstChild(Config.SWORD_NAME)
	if step == nil or sword == nil then
		return
	end

	task.wait(step.hitStart)
	CombatEffects.playBladeTrail(sword, step.hitEnd - step.hitStart)
end)

-- Impact validé par le serveur (coup d'un autre joueur ou du boss). Pour nos propres coups,
-- l'effet a déjà été joué à la détection. La caméra ne tremble que si c'est nous qui encaissons.
Remotes.HitConfirmed.OnClientEvent:Connect(function(attacker: Model?, target: Model?, _damage: number)
	local localCharacter = localPlayer.Character
	if target and attacker ~= localCharacter then
		CombatEffects.playSwordHit(attacker, target, nil, target == localCharacter)
	end
end)

-- Ultime validé par le serveur (le nôtre ou celui d'un autre joueur) : place au spectacle,
-- aux couleurs de la magie du lanceur.
Remotes.UltimateFired.OnClientEvent:Connect(function(caster: Model?, origin: Vector3, targets: { Model }, magicId: string)
	if typeof(origin) == "Vector3" and type(targets) == "table" then
		CombatEffects.playUltimate(caster, origin, targets, MagicConfig.getById(magicId))
	end
end)
]]></ProtectedString>
