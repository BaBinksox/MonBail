					<bool name="DefinesCapabilities">false</bool>
					<string name="Name">AvatarSerializer</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				</Properties>
			</Item>
		</Item>
		<Item class="Folder" referent="RBXAB3CDF2A201340E998DAF5336644D47D">
			<Properties>
				<Color3 name="IconTint">
					<R>0</R>
					<G>0</G>
					<B>0</B>
				</Color3>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<string name="Name">Combat</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
			</Properties>
			<Item class="ModuleScript" referent="RBX6B19850C358D4292BAFECA02C91F6DA1">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	CombatService
	Façade serveur du combat (singleton).
		- équipe chaque personnage de son épée (Motor6D, voir SwordFactory) ;
		- valide les demandes d'attaque : état du joueur, ordre et cadence du combo ;
		- valide chaque impact signalé par le client : fenêtre de frappe, cible autorisée, distance,
		  ligne de vue (raycast serveur), une seule touche par cible et par coup ;
		- applique les dégâts et l'éjection. C'est le SEUL endroit du jeu où un coup d'épée blesse ;
		- tient la Tension de chaque joueur (gagnée à chaque impact validé) et déclenche le pouvoir
		  ultime de sa Magie Innée : jauge vérifiée ici, vidée ici, dégâts de zone infligés ici.

	Le client détecte les impacts (zone de frappe devant lui, sans latence), mais il ne fait que
	DEMANDER : il n'envoie ni dégâts ni position, seulement "j'ai touché ce Model".

	Le serveur ne vérifie pas l'orientation de l'attaquant : avec le soft-lock, il se tourne
	instantanément vers sa cible, et cette rotation n'est pas encore répliquée quand l'impact
	arrive. Ce qui compte, et qui est vérifié, c'est que la cible soit à portée de sa zone de frappe.
]]

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Combat.CombatConfig)
local MagicConfig = require(ReplicatedStorage.Shared.Magic.MagicConfig)
local Remotes = require(ReplicatedStorage.Shared.Combat.CombatRemotes)
local SpatialHitbox = require(ReplicatedStorage.Shared.Combat.SpatialHitbox)
local TimeLoopConfig = require(ReplicatedStorage.Shared.TimeLoop.TimeLoopConfig)

local AvatarService = require(script.Parent.Parent.Avatar.AvatarService)
local MovementService = require(script.Parent.Parent.Movement.MovementService)
local SwordFactory = require(script.Parent.SwordFactory)
local TimeLoopService = require(script.Parent.Parent.TimeLoop.TimeLoopService)
local UltimateBehaviors = require(script.Parent.UltimateBehaviors)

-- Dernier coup accepté d'un joueur.
type AttackState = {
	comboIndex: number,
	startClock: number,
	hitTargets: { [Model]: boolean }, -- cibles déjà blessées par ce coup
}

local HAND_READY_TIMEOUT = 10 -- secondes d'attente maximum pour qu'une main (ou son point de prise) existe
local KNOCKBACK_MAX_FORCE = 1e6 -- assez pour imposer la vitesse d'éjection malgré le Humanoid de la cible

local CombatService = {}

local attacks: { [Player]: AttackState } = {}
local isStarted = false

--------------------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------------------

local function logRejection(player: Player, reason: string)
	if Config.DEBUG_LOGS then
		print(`[Combat] Refusé pour {player.Name} : {reason}`)
	end
end

-- Retourne le Humanoid et le RootPart d'un personnage vivant, sinon nil.
local function getLivingParts(character: Model?): (Humanoid?, BasePart?)
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = humanoid and humanoid.RootPart
	if humanoid == nil or rootPart == nil or humanoid.Health <= 0 then
		return nil, nil
	end
	return humanoid, rootPart
end

-- Un joueur figé par un autre système (Hub, anomalie, rewind) est hors combat :
-- il ne peut ni frapper ni être frappé.
local function isOutOfCombat(player: Player): boolean
	return AvatarService.isCustomizing(player) or TimeLoopService.isInAnomaly(player) or TimeLoopService.isRewinding()
end

local function isInvulnerable(target: Model): boolean
	return target:GetAttribute(Config.INVULNERABLE_ATTRIBUTE) == true
end

--------------------------------------------------------------------------------
-- Tension
--------------------------------------------------------------------------------
-- La Tension vit dans un attribut du Player : écrite ici, répliquée automatiquement au client
-- pour sa jauge. Une modification faite par un client reste chez lui, le serveur ne la voit pas.

local function getTension(player: Player): number
	local tension = player:GetAttribute(Config.TENSION_ATTRIBUTE)
	return if type(tension) == "number" then tension else 0
end

local function setTension(player: Player, tension: number)
	player:SetAttribute(Config.TENSION_ATTRIBUTE, math.clamp(tension, 0, Config.TENSION_MAX))
end

--------------------------------------------------------------------------------
-- Épée
--------------------------------------------------------------------------------

local function equipSword(character: Model)
	local sword = SwordFactory.create()

	-- YIELD : attend que la main ait son point de prise avant d'y fixer l'épée.
	local function attachTo(hand: Instance)
		if not hand:IsA("BasePart") then
			return
		end
		hand:WaitForChild(Config.GRIP_ATTACHMENT_NAME, HAND_READY_TIMEOUT)

		-- Entre-temps la main a pu être remplacée à son tour : seule la main actuelle compte.
		if hand.Parent == character and SwordFactory.attach(sword, hand) then
			sword.Parent = character -- seulement une fois fixée : libre, elle tomberait dans le vide
		end
	end

	-- ApplyDescription remplace le RightHand quand l'avatar change de bras (et détruit avec lui
	-- le Motor6D qui y était relié) : on refixe l'épée chaque fois qu'une main droite apparaît.
	character.ChildAdded:Connect(function(child: Instance)
		if child.Name == Config.HAND_NAME then
			attachTo(child)
		end
	end)

	task.spawn(function()
		local hand = character:WaitForChild(Config.HAND_NAME, HAND_READY_TIMEOUT)
		if hand then
			attachTo(hand)
		else
			warn(`[Combat] {character.Name} n'a pas de {Config.HAND_NAME} (rig R15 requis) : pas d'épée`)
		end
	end)

	character.Destroying:Connect(function()
		sword:Destroy()
	end)
end

--------------------------------------------------------------------------------
-- Validation d'une attaque
--------------------------------------------------------------------------------

-- Vérifie que `comboIndex` est un enchaînement plausible après `last`. Retourne (ok, raison du refus).
local function isComboStepAllowed(last: AttackState?, comboIndex: number, now: number): (boolean, string)
	if last == nil then
		return comboIndex == 1, "le combo doit commencer par le coup 1"
	end

	local lastEndClock = last.startClock + Config.COMBO[last.comboIndex].duration
	if now < lastEndClock - Config.LATENCY_TOLERANCE then
		return false, "coup précédent encore en cours"
	end
	if comboIndex == 1 then
		return true, ""
	end

	local isNextStep = comboIndex == last.comboIndex + 1
	local isInTime = now - lastEndClock <= Config.COMBO_RESET_DELAY + Config.LATENCY_TOLERANCE
	return isNextStep and isInTime, "enchaînement de combo invalide"
end

local function onAttackRequested(player: Player, comboIndex: any)
	if type(comboIndex) ~= "number" or Config.COMBO[comboIndex] == nil then
		return
	end

	local character = player.Character
	if getLivingParts(character) == nil or isOutOfCombat(player) then
		logRejection(player, "joueur hors combat")
		return
	end

	local now = os.clock()
	local isAllowed, reason = isComboStepAllowed(attacks[player], comboIndex, now)
	if not isAllowed then
		logRejection(player, reason)
		return
	end

	attacks[player] = {
		comboIndex = comboIndex,
		startClock = now,
		hitTargets = {},
	}

	-- L'animation de l'attaquant est répliquée par Roblox, mais pas ses VFX (traînée de lame) :
	-- les autres clients sont prévenus pour les jouer chez eux. L'attaquant, lui, l'a déjà fait.
	for _, otherPlayer in Players:GetPlayers() do
		if otherPlayer ~= player then
			Remotes.AttackStarted:FireClient(otherPlayer, character, comboIndex)
		end
	end

	if Config.DEBUG_LOGS then
		print(`[Combat] {player.Name} lance le coup {comboIndex} ({Config.COMBO[comboIndex].name})`)
	end
end

--------------------------------------------------------------------------------
-- Validation d'un impact
--------------------------------------------------------------------------------

-- Une cible valide est un PNJ taggé, ou le personnage d'un autre joueur si le PvP est actif.
-- Dans tous les cas, une cible déclarée invulnérable (boss en charge) ou en plein dash est épargnée.
local function isTargetAllowed(target: Model): boolean
	if isInvulnerable(target) then
		return false
	end

	local targetPlayer = Players:GetPlayerFromCharacter(target)
	if targetPlayer then
		return Config.PVP_ENABLED and not isOutOfCombat(targetPlayer) and not MovementService.isDashing(targetPlayer)
	end
	return CollectionService:HasTag(target, TimeLoopConfig.ENTITY_TAG)
end

-- Distance maximale (studs) entre l'attaquant et le bord d'une cible pour qu'elle ait pu se trouver
-- dans la zone de frappe de ce coup : le coin le plus éloigné de la boîte, plus la marge du serveur.
local function getMaxHitDistance(step: Config.ComboStep): number
	local halfWidth = Config.HITBOX_SIZE.X / 2
	local depth = Config.HITBOX_SIZE.Z + step.reachBonus
	return math.sqrt(depth * depth + halfWidth * halfWidth) + Config.HITBOX_RANGE_TOLERANCE
end

-- Distance mesurée jusqu'au bord de la cible (et non son centre), pour rester juste face à un gros boss.
local function isInRange(attackerRoot: BasePart, target: Model, targetRoot: BasePart, maxDistance: number): boolean
	local extents = target:GetExtentsSize()
	local targetRadius = math.max(extents.X, extents.Z) / 2
	local distance = (targetRoot.Position - attackerRoot.Position).Magnitude - targetRadius
	return distance <= maxDistance
end

-- Raycast serveur attaquant -> cible : aucun élément de décor solide ne doit les séparer.
local function hasLineOfSight(attacker: Model, attackerRoot: BasePart, target: Model, targetRoot: BasePart): boolean
	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	raycastParams.FilterDescendantsInstances = { attacker, target }
	raycastParams.RespectCanCollide = true

	local result = workspace:Raycast(attackerRoot.Position, targetRoot.Position - attackerRoot.Position, raycastParams)
	-- Un autre personnage sur la trajectoire ne protège pas la cible : seul le décor compte.
	return result == nil or SpatialHitbox.getCharacterFromPart(result.Instance) ~= nil
end

-- Éjecte `targetRoot` à l'opposé de l'attaquant : une LinearVelocity posée par le serveur le
-- temps de KNOCKBACK_DURATION. Elle agit aussi sur un joueur, dont le client simule la physique
-- (la contrainte lui est répliquée).
local function applyKnockback(attackerRoot: BasePart, targetRoot: BasePart, speed: number)
	if targetRoot.Anchored then
		return
	end

	local direction = (targetRoot.Position - attackerRoot.Position) * Vector3.new(1, 0, 1)
	if direction.Magnitude < 0.1 then
		direction = attackerRoot.CFrame.LookVector * Vector3.new(1, 0, 1)
	end

	local attachment = Instance.new("Attachment")
	attachment.Name = "KnockbackAttachment"
	attachment.Parent = targetRoot

	local velocity = Instance.new("LinearVelocity")
	velocity.Name = "KnockbackVelocity"
	velocity.Attachment0 = attachment
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	velocity.VectorVelocity = direction.Unit * speed + Vector3.new(0, Config.KNOCKBACK_LIFT, 0)
	velocity.MaxForce = KNOCKBACK_MAX_FORCE
	velocity.Parent = targetRoot

	Debris:AddItem(velocity, Config.KNOCKBACK_DURATION)
	Debris:AddItem(attachment, Config.KNOCKBACK_DURATION)
end

local function onHitReported(player: Player, target: any)
	if typeof(target) ~= "Instance" or not target:IsA("Model") then
		return
	end

	local attack = attacks[player]
	local attacker = player.Character
	local _, attackerRoot = getLivingParts(attacker)
	if attack == nil or attacker == nil or attackerRoot == nil or isOutOfCombat(player) then
		return
	end

	-- 1. Le coup doit être dans sa fenêtre de frappe.
	local step = Config.COMBO[attack.comboIndex]
	local elapsed = os.clock() - attack.startClock
	if elapsed < step.hitStart - Config.LATENCY_TOLERANCE or elapsed > step.hitEnd + Config.LATENCY_TOLERANCE then
		logRejection(player, "impact hors de la fenêtre de frappe")
		return
	end

	-- 2. La cible doit être légitime, vivante, et pas encore touchée par ce coup.
	local targetHumanoid, targetRoot = getLivingParts(target)
	if
		target == attacker
		or attack.hitTargets[target]
		or targetHumanoid == nil
		or targetRoot == nil
		or not isTargetAllowed(target)
	then
		return
	end

	-- 3. La géométrie doit rendre l'impact possible.
	if not isInRange(attackerRoot, target, targetRoot, getMaxHitDistance(step)) then
		logRejection(player, "cible hors de portée")
		return
	end
	if not hasLineOfSight(attacker, attackerRoot, target, targetRoot) then
		logRejection(player, "cible derrière un obstacle")
		return
	end

	attack.hitTargets[target] = true
	targetHumanoid:TakeDamage(step.damage)
	if step.knockback > 0 then
		applyKnockback(attackerRoot, targetRoot, step.knockback)
	end
	setTension(player, getTension(player) + Config.TENSION_PER_HIT)
	Remotes.HitConfirmed:FireAllClients(attacker, target, step.damage)

	if Config.DEBUG_LOGS then
		print(`[Combat] {player.Name} touche {target.Name} : -{step.damage} PV (reste {targetHumanoid.Health})`)
	end
end

--------------------------------------------------------------------------------
-- Pouvoir ultime
--------------------------------------------------------------------------------

-- Tous les PNJ taggés, vivants, à moins de `radius` studs de `origin`.
local function findUltimateTargets(origin: Vector3, radius: number): { Model }
	local targets = {}
	for _, instance in CollectionService:GetTagged(TimeLoopConfig.ENTITY_TAG) do
		if instance:IsA("Model") and instance:IsDescendantOf(workspace) then
			local _, rootPart = getLivingParts(instance)
			if rootPart and (rootPart.Position - origin).Magnitude <= radius then
				table.insert(targets, instance)
			end
		end
	end
	return targets
end

local function onUltimateRequested(player: Player)
	local caster = player.Character
	local _, casterRoot = getLivingParts(caster)
	if caster == nil or casterRoot == nil or isOutOfCombat(player) then
		logRejection(player, "ultime demandé hors combat")
		return
	end
	if getTension(player) < Config.TENSION_MAX then
		logRejection(player, "ultime demandé sans Tension pleine")
		return
	end

	-- La jauge est vidée AVANT tout le reste : deux demandes rapprochées ne donnent qu'un ultime.
	setTension(player, 0)

	-- L'ultime est celui de la Magie Innée du joueur : l'attribut est écrit par AvatarService,
	-- côté serveur, donc le client ne peut pas s'en attribuer une autre.
	local magic = MagicConfig.getById(player:GetAttribute(MagicConfig.ATTRIBUTE))
	local origin = casterRoot.Position
	local targets = findUltimateTargets(origin, magic.radius)
	Remotes.UltimateFired:FireAllClients(caster, origin, targets, magic.id)

	if Config.DEBUG_LOGS then
		print(`[Combat] {player.Name} déclenche {magic.ultimateName} : {#targets} cible(s)`)
	end

	-- Les dégâts tombent à la fin de l'arrêt sur image des clients, quand l'onde de choc part.
	task.wait(Config.ULTIMATE_HIT_STOP)
	if TimeLoopService.isRewinding() then
		return -- le temps a été rembobiné entre-temps : l'explosion n'a "pas eu lieu"
	end
	local damageDealt = 0
	for _, target in targets do
		local targetHumanoid = getLivingParts(target)
		if targetHumanoid and not isInvulnerable(target) then
			local healthBefore = targetHumanoid.Health
			targetHumanoid:TakeDamage(magic.damage)
			damageDealt += healthBefore - targetHumanoid.Health
		end
	end

	-- Effet propre à la magie (implosion, brûlure, paralysie, gel, drain) : voir UltimateBehaviors.
	local casterHumanoid = getLivingParts(caster)
	if casterHumanoid then
		task.spawn(UltimateBehaviors.run, {
			casterHumanoid = casterHumanoid,
			origin = origin,
			targets = targets,
			magic = magic,
			damageDealt = damageDealt,
		})
	end
end

--------------------------------------------------------------------------------
-- Cycle de vie des joueurs
--------------------------------------------------------------------------------

local function onPlayerAdded(player: Player)
	setTension(player, 0)

	player.CharacterAdded:Connect(function(character: Model)
		attacks[player] = nil
		setTension(player, 0) -- la Tension accumulée est perdue à la mort
		equipSword(character)
	end)
	if player.Character then
		equipSword(player.Character)
	end
end

local function onPlayerRemoving(player: Player)
	attacks[player] = nil
end

--------------------------------------------------------------------------------
-- API publique
--------------------------------------------------------------------------------

-- À appeler une seule fois au démarrage du serveur.
function CombatService.start()
	if isStarted then
		return
	end
	isStarted = true

	Remotes.RequestAttack.OnServerEvent:Connect(onAttackRequested)
	Remotes.ReportHit.OnServerEvent:Connect(onHitReported)
	Remotes.RequestUltimate.OnServerEvent:Connect(onUltimateRequested)

	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		onPlayerAdded(player)
	end
end

return CombatService
]]></ProtectedString>
					<string name="ScriptGuid">{37366B00-A784-4E31-846A-7C69A6F58B27}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<string name="Name">CombatService</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBXE53B63BC2DC244FC92DEEA96F8A21836">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	SwordFactory
	Fabrique l'épée d'un personnage et la fixe dans sa main droite par un Motor6D (pas de Tool).

	Source du modèle :
		- ServerStorage > Assets > Sword s'il existe et qu'il est conforme :
		    * un Model dont le PrimaryPart est la poignée (c'est lui qui est tenu en main) ;
		    * toutes ses pièces soudées entre elles ;
		    * deux Attachments nommés BladeStart (base de la lame) et BladeEnd (pointe) ;
		    * l'axe Y du PrimaryPart pointe de la poignée vers la pointe.
		- sinon, une épée provisoire en Parts est générée par code.

	Jointures :
		- pièces de l'épée entre elles : des Weld à décalage EXPLICITE (C0). Pas de WeldConstraint
		  ici : son décalage est déduit de la position des pièces au moment où il devient actif,
		  ce qui est fragile quand le Motor6D déplace la poignée dans la main au même instant
		  (la lame peut rester soudée loin de la poignée).
		- épée -> main : un Motor6D recréé à chaque attach(), Part0 = RightHand, Part1 = poignée.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Config = require(ReplicatedStorage.Shared.Combat.CombatConfig)

-- Dimensions de l'épée provisoire (studs). L'axe Y de la poignée va vers la pointe.
local GRIP_SIZE = Vector3.new(0.25, 1.1, 0.25)
local GUARD_SIZE = Vector3.new(1.1, 0.18, 0.3)
local BLADE_SIZE = Vector3.new(0.32, 3.6, 0.08)
local GUARD_OFFSET_Y = GRIP_SIZE.Y / 2 + GUARD_SIZE.Y / 2
local BLADE_START_Y = GRIP_SIZE.Y / 2 + GUARD_SIZE.Y
local BLADE_END_Y = BLADE_START_Y + BLADE_SIZE.Y

-- Traînée de lame : blanc froid à la lame, violet en bout de sillage.
local TRAIL_LIFETIME = 0.18 -- secondes de persistance du sillage
local TRAIL_COLOR_HEAD = Color3.fromRGB(235, 240, 255)
local TRAIL_COLOR_TAIL = Color3.fromRGB(150, 90, 255)

-- Prise standard d'une main R15, utilisée si la main n'a pas (encore) son RightGripAttachment.
local DEFAULT_GRIP_CFRAME = CFrame.new(0, -0.15, 0) * CFrame.Angles(math.rad(-90), 0, 0)

local SwordFactory = {}

--------------------------------------------------------------------------------
-- Épée provisoire
--------------------------------------------------------------------------------

local function newPart(name: string, size: Vector3, color: Color3, material: Enum.Material): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = material
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	return part
end

-- Soude `part` à la poignée, à `offset` du centre de celle-ci.
local function weldToHandle(handle: BasePart, part: BasePart, offset: CFrame)
	part.CFrame = handle.CFrame * offset

	local weld = Instance.new("Weld")
	weld.Name = "SwordWeld"
	weld.Part0 = handle
	weld.Part1 = part
	weld.C0 = offset
	weld.Parent = part
end

local function newAttachment(name: string, offsetY: number, parent: BasePart)
	local attachment = Instance.new("Attachment")
	attachment.Name = name
	attachment.Position = Vector3.new(0, offsetY, 0)
	attachment.Parent = parent
end

local function buildPlaceholder(): Model
	local sword = Instance.new("Model")
	sword.Name = Config.SWORD_NAME

	local handle = newPart("Handle", GRIP_SIZE, Color3.fromRGB(45, 32, 26), Enum.Material.Wood)
	handle.Parent = sword
	sword.PrimaryPart = handle

	local guard = newPart("Guard", GUARD_SIZE, Color3.fromRGB(70, 62, 50), Enum.Material.Metal)
	guard.Parent = sword
	weldToHandle(handle, guard, CFrame.new(0, GUARD_OFFSET_Y, 0))

	local blade = newPart("Blade", BLADE_SIZE, Color3.fromRGB(170, 175, 185), Enum.Material.Metal)
	blade.Parent = sword
	weldToHandle(handle, blade, CFrame.new(0, BLADE_START_Y + BLADE_SIZE.Y / 2, 0))

	newAttachment(Config.BLADE_START_NAME, BLADE_START_Y, handle)
	newAttachment(Config.BLADE_END_NAME, BLADE_END_Y, handle)

	return sword
end

--------------------------------------------------------------------------------
-- Modèle fourni par le développeur
--------------------------------------------------------------------------------

local function isValidTemplate(template: Instance): boolean
	return template:IsA("Model")
		and template.PrimaryPart ~= nil
		and template:FindFirstChild(Config.BLADE_START_NAME, true) ~= nil
		and template:FindFirstChild(Config.BLADE_END_NAME, true) ~= nil
end

local function cloneTemplate(): Model?
	local assets = ServerStorage:FindFirstChild(Config.ASSETS_FOLDER_NAME)
	local template = assets and assets:FindFirstChild(Config.SWORD_NAME)
	if template == nil then
		return nil
	end
	if not isValidTemplate(template) then
		warn("[Combat] ServerStorage.Assets.Sword est invalide (PrimaryPart, BladeStart ou BladeEnd manquant) : épée provisoire utilisée")
		return nil
	end
	return template:Clone() :: Model
end

--------------------------------------------------------------------------------
-- Traînée de lame
--------------------------------------------------------------------------------

-- Ajoute un Trail tendu entre la base et la pointe de la lame : un ruban lumineux qui suit le
-- mouvement. Il est créé ÉTEINT ; ce sont les clients qui l'allument pendant la fenêtre de frappe
-- (voir CombatEffects.playBladeTrail), jamais le serveur.
local function addBladeTrail(sword: Model)
	local handle = sword.PrimaryPart
	local bladeStart = sword:FindFirstChild(Config.BLADE_START_NAME, true)
	local bladeEnd = sword:FindFirstChild(Config.BLADE_END_NAME, true)
	if
		handle == nil
		or bladeStart == nil
		or bladeEnd == nil
		or not bladeStart:IsA("Attachment")
		or not bladeEnd:IsA("Attachment")
	then
		return
	end

	local trail = Instance.new("Trail")
	trail.Name = Config.BLADE_TRAIL_NAME
	trail.Enabled = false
	trail.Attachment0 = bladeStart
	trail.Attachment1 = bladeEnd
	trail.Lifetime = TRAIL_LIFETIME
	trail.MinLength = 0.02
	trail.FaceCamera = false -- le ruban garde la largeur réelle de la lame
	trail.LightEmission = 1
	trail.LightInfluence = 0
	trail.Color = ColorSequence.new(TRAIL_COLOR_HEAD, TRAIL_COLOR_TAIL)
	trail.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(0.6, 0.55),
		NumberSequenceKeypoint.new(1, 1),
	})
	trail.Parent = handle
end

--------------------------------------------------------------------------------
-- API publique
--------------------------------------------------------------------------------

-- Crée une épée prête à être fixée (non parentée). À détruire avec le personnage.
function SwordFactory.create(): Model
	local sword = cloneTemplate() or buildPlaceholder()
	sword.Name = Config.SWORD_NAME

	-- Sur l'épée provisoire comme sur un modèle fourni, sauf si celui-ci a déjà sa traînée.
	if sword:FindFirstChild(Config.BLADE_TRAIL_NAME, true) == nil then
		addBladeTrail(sword)
	end

	-- Sur TOUTES les pièces : l'épée ne doit ni heurter le décor ou le personnage (CanCollide),
	-- ni peser sur lui (Massless), ni arrêter les rayons des hitboxes (CanQuery).
	for _, descendant in sword:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = false
			descendant.CanCollide = false
			descendant.CanQuery = false
			descendant.CanTouch = false
			descendant.Massless = true
		end
	end

	return sword
end

-- Fixe la poignée de l'épée dans `hand` (le RightHand du personnage). Peut être rappelée à
-- volonté : l'ancien Motor6D est remplacé, ce qui permet de suivre un changement de main.
function SwordFactory.attach(sword: Model, hand: BasePart): boolean
	local handle = sword.PrimaryPart
	if handle == nil then
		return false
	end

	local previousMotor = handle:FindFirstChild(Config.SWORD_MOTOR_NAME)
	if previousMotor then
		previousMotor:Destroy()
	end

	local gripAttachment = hand:FindFirstChild(Config.GRIP_ATTACHMENT_NAME)
	local gripCFrame = if gripAttachment and gripAttachment:IsA("Attachment")
		then gripAttachment.CFrame
		else DEFAULT_GRIP_CFRAME

	local motor = Instance.new("Motor6D")
	motor.Name = Config.SWORD_MOTOR_NAME
	motor.Part0 = hand
	motor.Part1 = handle
	motor.C0 = gripCFrame * Config.SWORD_GRIP_OFFSET
	motor.Parent = handle

	return true
end

return SwordFactory
]]></ProtectedString>
					<string name="ScriptGuid">{D4B42DD4-BC40-4F9C-9196-6E42D26C7F00}</string>
					<BinaryString name="AttributesSerialize"></BinaryString>
					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<string name="Name">SwordFactory</string>
					<BinaryString name="SerializedOverrides"></BinaryString>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX17818389F2654763B00B790132F4CE51">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
--[[
	UltimateBehaviors
	Ce qui rend les cinq ultimes DIFFÉRENTS en jeu, au-delà de leur rayon et de leurs dégâts.

	CombatService inflige les dégâts de zone communs, puis appelle run() : l'effet propre à la magie
	du lanceur s'applique alors aux cibles encore en vie.
		antimatter : implosion   - les survivants sont aspirés vers le lanceur (à portée d'épée) ;
		pyromancy  : brûlure     - ils continuent de perdre des PV pendant quelques secondes ;
		lightning  : paralysie   - ils ne peuvent plus bouger un court instant ;
		ice        : gel         - ils sont fortement ralentis, longtemps ;
		shadow     : drain       - le lanceur récupère une part des dégâts infligés.

	Ajouter ou changer un effet : une fonction dans BEHAVIORS, rangée sous l'`id` de la magie.
	Une magie sans entrée n'a simplement pas d'effet secondaire.
]]

local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CombatConfig = require(ReplicatedStorage.Shared.Combat.CombatConfig)
local MagicConfig = require(ReplicatedStorage.Shared.Magic.MagicConfig)

local TimeLoopService = require(script.Parent.Parent.TimeLoop.TimeLoopService)

export type Context = {
	casterHumanoid: Humanoid,
	origin: Vector3, -- position du lanceur au moment de l'ultime
	targets: { Model }, -- cibles touchées par les dégâts de zone
	magic: MagicConfig.Magic,
	damageDealt: number, -- total des PV retirés par les dégâts de zone
}

-- Antimatière
local PULL_SPEED = 45 -- studs/s
local PULL_DURATION = 0.3
local PULL_STOP_DISTANCE = 5 -- studs : on n'aspire pas une cible déjà au contact
-- Pyromancie
local BURN_TICKS = 5
local BURN_TICK_INTERVAL = 1
local BURN_TICK_DAMAGE = 6
-- Foudre
local STUN_DURATION = 1.5
-- Glace
local SLOW_FACTOR = 0.35 -- vitesse restante
local SLOW_DURATION = 5
-- Ombre
local DRAIN_RATIO = 0.4 -- part des dégâts rendue au lanceur

-- Attributs posés sur le Humanoid ralenti, pour que deux effets de vitesse ne se marchent pas dessus.
local BASE_SPEED_ATTRIBUTE = "BaseWalkSpeed"
local SPEED_TOKEN_ATTRIBUTE = "SpeedEffectToken"

local UltimateBehaviors = {}

--------------------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------------------

-- Humanoid et RootPart d'une cible encore vivante et vulnérable, sinon nil.
local function getAffectableParts(target: Model): (Humanoid?, BasePart?)
	local humanoid = target:FindFirstChildOfClass("Humanoid")
	local rootPart = humanoid and humanoid.RootPart
	if humanoid == nil or rootPart == nil or humanoid.Health <= 0 then
		return nil, nil
	end
	if target:GetAttribute(CombatConfig.INVULNERABLE_ATTRIBUTE) == true then
		return nil, nil
	end
	return humanoid, rootPart
end

-- Multiplie la vitesse de marche de `humanoid` par `factor` pendant `duration` secondes.
-- Un effet plus récent remplace le précédent ; la vitesse d'origine est toujours rendue à la fin.
local function applySpeedFactor(humanoid: Humanoid, factor: number, duration: number)
	local baseSpeed = humanoid:GetAttribute(BASE_SPEED_ATTRIBUTE)
	if type(baseSpeed) ~= "number" then
		baseSpeed = humanoid.WalkSpeed
		humanoid:SetAttribute(BASE_SPEED_ATTRIBUTE, baseSpeed)
	end

	local token = ((humanoid:GetAttribute(SPEED_TOKEN_ATTRIBUTE) :: number?) or 0) + 1
	humanoid:SetAttribute(SPEED_TOKEN_ATTRIBUTE, token)
	humanoid.WalkSpeed = (baseSpeed :: number) * factor

	task.delay(duration, function()
		if humanoid:GetAttribute(SPEED_TOKEN_ATTRIBUTE) == token then
			humanoid.WalkSpeed = baseSpeed :: number
			humanoid:SetAttribute(BASE_SPEED_ATTRIBUTE, nil)
		end
	end)
end

--------------------------------------------------------------------------------
-- Effets par magie
--------------------------------------------------------------------------------

local BEHAVIORS: { [string]: (Context) -> () } = {
	-- Implosion : une LinearVelocity brève tire chaque survivant vers le point d'origine.
	antimatter = function(context: Context)
		for _, target in context.targets do
			local _, rootPart = getAffectableParts(target)
			if rootPart and not rootPart.Anchored then
				local toOrigin = (context.origin - rootPart.Position) * Vector3.new(1, 0, 1)
				if toOrigin.Magnitude > PULL_STOP_DISTANCE then
					local attachment = Instance.new("Attachment")
					attachment.Name = "PullAttachment"
					attachment.Parent = rootPart

					local velocity = Instance.new("LinearVelocity")
					velocity.Name = "PullVelocity"
					velocity.Attachment0 = attachment
					velocity.RelativeTo = Enum.ActuatorRelativeTo.World
					velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
					velocity.VectorVelocity = toOrigin.Unit * PULL_SPEED
					velocity.MaxForce = 1e6
					velocity.Parent = rootPart

					Debris:AddItem(velocity, PULL_DURATION)
					Debris:AddItem(attachment, PULL_DURATION)
				end
			end
		end
	end,

	-- Brûlure : des dégâts répétés. Ils s'interrompent si le temps est rembobiné entre-temps.
	pyromancy = function(context: Context)
		for _ = 1, BURN_TICKS do
			task.wait(BURN_TICK_INTERVAL)
			if TimeLoopService.isRewinding() then
				return
			end
			for _, target in context.targets do
				local humanoid = getAffectableParts(target)
				if humanoid then
					humanoid:TakeDamage(BURN_TICK_DAMAGE)
				end
			end
		end
	end,

	-- Paralysie : vitesse nulle un court instant.
	lightning = function(context: Context)
		for _, target in context.targets do
			local humanoid = getAffectableParts(target)
			if humanoid then
				applySpeedFactor(humanoid, 0, STUN_DURATION)
			end
		end
	end,

	-- Gel : fort ralentissement, plus long.
	ice = function(context: Context)
		for _, target in context.targets do
			local humanoid = getAffectableParts(target)
			if humanoid then
				applySpeedFactor(humanoid, SLOW_FACTOR, SLOW_DURATION)
			end
		end
	end,

	-- Drain : le lanceur se soigne d'une part des dégâts qu'il vient d'infliger.
	shadow = function(context: Context)
		local humanoid = context.casterHumanoid
		if humanoid.Health > 0 then
			humanoid.Health = math.min(humanoid.Health + context.damageDealt * DRAIN_RATIO, humanoid.MaxHealth)
		end
	end,
}

--------------------------------------------------------------------------------
-- API publique
--------------------------------------------------------------------------------

-- Applique l'effet secondaire de `context.magic`. Peut YIELD (brûlure) : à lancer avec task.spawn.
function UltimateBehaviors.run(context: Context)
	local behavior = BEHAVIORS[context.magic.id]
	if behavior then
		behavior(context)
	end
end

return UltimateBehaviors
]]></ProtectedString>
